# Copia este archivo como .env y rellena con los datos reales.
# NUNCA subas el .env a git — está en .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings > API en el dashboard de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_JWT_SECRET=tu-jwt-secret

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=Certificador de Calidad del Aire Cali
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://tu-frontend.vercel.app

# ── Blockchain (Ethereum / HashKey Chain) ─────────────────────────────────
# Pon en false para correr sin wallet (modo DRY_RUN, útil para desarrollo)
BLOCKCHAIN_ENABLED=false

# RPC del nodo al que te conectas:
#   HashKey Chain testnet:  https://hashkeychain-testnet.alt.technology
#   HashKey Chain mainnet:  https://mainnet.hsk.xyz
#   Ethereum Sepolia:       https://rpc.sepolia.org
#   Ethereum mainnet:       https://cloudflare-eth.com
BLOCKCHAIN_RPC_URL=https://hashkeychain-testnet.alt.technology

# Dirección del contrato AirQualityCertifier ya desplegado en la red elegida
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Clave privada de la wallet que firmará las transacciones de certificación.
# ⚠️  NUNCA la compartas ni la subas a git.
# Obtén HSK de prueba en: https://faucet.hsk.xyz (testnet)
BLOCKCHAIN_PRIVATE_KEY=0xtuprivatekey
